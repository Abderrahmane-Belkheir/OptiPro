# Used only by `npm run dev` (never `npm run build`) — the website and backend run as two
# separate dev servers locally, so fetch calls need an absolute origin. A production build is
# meant to be served BY the backend (see backend/resources/README.md) at the same origin, so it
# intentionally has no equivalent .env.production entry — VITE_API_ORIGIN stays empty there.
VITE_API_ORIGIN=http://localhost:4000
