// Local SQLite mirror of the Postgres schema (../schema.prisma), for this desktop app's own
// offline/local storage — a separate schema file because one Prisma schema can only target one
// datasource provider at a time.
//
// SQLite has no native list/array column type (unlike Postgres), so `images`/`colors` here are
// JSON-encoded TEXT columns instead of `String[]` — see src/lib/sqliteClient.ts for the
// encode/decode helpers that keep the app-facing shape identical to the Postgres models.
//
// Only brands, categories, frames, accessories, customers and tenants exist on the backend so far;
// the models from `Prescription` down are local-only until the backend gets matching tables.
//
// After editing this file, regenerate the client and the SQL the app runs on start:
//   npx prisma generate --schema prisma/sqlite/schema.prisma
//   npx prisma migrate diff --from-empty --to-schema prisma/sqlite/schema.prisma \n//     --config prisma/sqlite/prisma.config.ts --script > prisma/sqlite/init.sql

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
}

model Brand {
  /// Made here (a UUID) like the id of every other table, and the same on the server: nothing to translate.
  id   String @id @default(uuid())
  name String

  /**
   * Whether this row has been sent to the backend. Local-only column — never sent.
   */
  synced Boolean @default(false)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  frames Frame[]

  @@unique([tenantKey, name])
  @@map("brands")
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique
  imageUrl String @map("image_url")

  frames Frame[]

  @@map("categories")
}

model Frame {
  id       String  @id
  name     String
  price    Float?
  currency String?
  /**
   * JSON-encoded string[] — see note at the top of this file.
   */
  images   String  @default("[]")
  shape    String?
  /**
   * JSON-encoded string[] — see note at the top of this file.
   */
  colors   String  @default("[]")
  stock    Int     @default(0)

  brandId    String   @map("brand_id")
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  /**
   * Whether this row has been sent to the backend. Local-only column — never sent.
   */
  synced Boolean @default(false)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  orderItems OrderItem[]

  /// Printed on every frame: eye size, bridge and temple length in mm (e.g. 52-18-140).
  eyeSize      Int?    @map("eye_size")
  bridge       Int?
  templeLength Int?    @map("temple_length")
  /// Manufacturer model code.
  reference    String?
  costPrice    Float?  @map("cost_price")

  /// The shop's own short code for this product (what labels and the website show). Optional for now; unique per shop when set. The
  /// id stays the internal key: this is the code people read, say and scan. A simple code (3 lowercase letters, a dash, 3 digits: abc-123), made here, never reused.
  code String?

  productImages ProductImage[]

  @@unique([tenantKey, code])
  @@map("frames")
}

model Accessory {
  id          String  @id
  name        String
  description String
  price       Float?
  currency    String?
  /**
   * JSON-encoded string[] — see note at the top of this file.
   */
  images      String  @default("[]")
  stock       Int     @default(0)

  /**
   * Whether this row has been sent to the backend. Local-only column — never sent.
   */
  synced Boolean @default(false)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  orderItems OrderItem[]

  costPrice Float? @map("cost_price")

  /// The shop's own short code for this product (what labels and the website show); see Frame.code.
  code String?

  productImages ProductImage[]

  @@unique([tenantKey, code])
  @@map("accessories")
}

/**
 * Where to look for the photos of a product: one row per photo, with the photo's id (the one the server
 * knows it by: GET /api/images/<id>) and the product it belongs to, EITHER a frame OR an accessory (one
 * of the two columns is filled, the other is null). A photo row goes when its product is deleted.
 */
model ProductImage {
  id String @id

  /**
   * Whether this photo has been sent to the server. Local-only column, false until it is. It decides
   * nothing about showing the photo: a photo is listed and rendered whether or not it is synced.
   */
  synced Boolean @default(false)

  frameId     String?    @map("frame_id")
  frame       Frame?     @relation(fields: [frameId], references: [id], onDelete: Cascade)
  accessoryId String?    @map("accessory_id")
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  /**
   * Whether this row has been sent to the backend. Local-only column — never sent.
   */
  synced Boolean @default(false)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  prescriptions Prescription[]
  orders        Order[]
  payments      Payment[]
  invoices      Invoice[]

  dateOfBirth DateTime? @map("date_of_birth")

  @@map("customers")
}

model Tenant {
  key  String @id
  host String @unique
  name String

  instagramUrl String? @map("instagram_url")
  tiktokUrl    String? @map("tiktok_url")
  phone        String?
  email        String?
  address      String?

  brands      Brand[]
  frames      Frame[]
  accessories Accessory[]
  customers   Customer[]

  prescriptions   Prescription[]
  lenses          Lens[]
  orders          Order[]
  orderItems      OrderItem[]
  payments        Payment[]
  invoices        Invoice[]
  invoiceItems    InvoiceItem[]
  numberSequences NumberSequence[]

  @@map("tenants")
}

// ====================================================================================
// Shop management: prescriptions, lenses, orders, payments, invoices.
// Every table below belongs to one tenant, has a client-generated UUID id (so rows can be
// created offline), a local-only `synced` flag, and money in integer minor units (centimes).
// ====================================================================================

model Prescription {
  id             String   @id @default(uuid())
  customerId     String   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Date written on the prescription.
  prescribedAt   DateTime @map("prescribed_at")
  prescriberName String?  @map("prescriber_name")

  // Right eye — sphere, cylinder and add in dioptres, axis in degrees (0-180).
  rightSphere   Float? @map("right_sphere")
  rightCylinder Float? @map("right_cylinder")
  rightAxis     Int?   @map("right_axis")
  rightAdd      Float? @map("right_add")
  // Left eye
  leftSphere    Float? @map("left_sphere")
  leftCylinder  Float? @map("left_cylinder")
  leftAxis      Int?   @map("left_axis")
  leftAdd       Float? @map("left_add")

  /// Pupillary distance, millimetres.
  pd       Float?
  notes    String?
  /// Photo or scan of the paper prescription.
  imageUrl String? @map("image_url")

  orders Order[]

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pdRight            Float? @map("pd_right")
  pdLeft             Float? @map("pd_left")
  /// Height of the pupil above the bottom of the frame, mm — needed for progressives and bifocals.
  fittingHeightRight Float? @map("fitting_height_right")
  fittingHeightLeft  Float? @map("fitting_height_left")

  @@index([customerId, prescribedAt])
  @@map("prescriptions")
}

model Lens {
  id              String  @id @default(uuid())
  name            String
  /// single_vision | bifocal | progressive
  design          String  @default("single_vision")
  /// organic | polycarbonate | mineral | high_index
  material        String  @default("organic")
  refractiveIndex Float?  @map("refractive_index")
  antiReflective  Boolean @default(false) @map("anti_reflective")
  blueLightFilter Boolean @default(false) @map("blue_light_filter")
  photochromic    Boolean @default(false)
  /// What the shop charges for this lens, in minor units (centimes). It is not tied to a pair or to one lens: the order line says how many and for which eye.
  priceCents      Int     @default(0) @map("price_cents")
  costCents       Int     @default(0) @map("cost_cents")
  isActive        Boolean @default(true) @map("is_active")

  orderItems OrderItem[]

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  polarized Boolean @default(false)
  tint      String?

  /// The power interval this lens can be made for. All optional: an empty limit means "no limit known". Cylinder is in the same
  /// sign as the prescriptions are written (usually minus). Add only applies to bifocal and progressive lenses.
  sphereMin     Float? @map("sphere_min")
  sphereMax     Float? @map("sphere_max")
  cylinderMin   Float? @map("cylinder_min")
  cylinderMax   Float? @map("cylinder_max")
  addMin        Float? @map("add_min")
  addMax        Float? @map("add_max")
  /// The largest allowed |sphere + cylinder| (the strongest meridian), when the maker gives such a limit.
  combinedLimit Float? @map("combined_limit")

  /// How many days the lab usually needs, and the smallest fitting height (mm) a progressive can be made for (its corridor length).
  leadTimeDays     Int?   @map("lead_time_days")
  minFittingHeight Float? @map("min_fitting_height")

  /// Who makes it (Essilor, Zeiss, ...), the maker's or the supplier's code for it, and anything else worth knowing.
  brand     String?
  reference String?
  notes     String?

  @@map("lenses")
}

model Order {
  id             String        @id @default(uuid())
  /// Human-readable, e.g. CMD-2026-0042. Unique per shop.
  number         String
  customerId     String?       @map("customer_id")
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  prescriptionId String?       @map("prescription_id")
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  /// confirmed | at_lab | ready | delivered | cancelled
  status      String    @default("confirmed")
  orderedAt   DateTime  @default(now()) @map("ordered_at")
  promisedAt  DateTime? @map("promised_at")
  deliveredAt DateTime? @map("delivered_at")

  /// Amounts in minor units (centimes), fixed at sale time so later price changes don't rewrite history.
  subtotalCents Int     @default(0) @map("subtotal_cents")
  discountCents Int     @default(0) @map("discount_cents")
  totalCents    Int     @default(0) @map("total_cents")
  notes         String?

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantKey, number])
  @@index([customerId])
  @@index([tenantKey, status])
  @@map("orders")
}

model OrderItem {
  id          String     @id @default(uuid())
  orderId     String     @map("order_id")
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// frame | lens | accessory | service
  kind        String
  frameId     String?    @map("frame_id")
  frame       Frame?     @relation(fields: [frameId], references: [id])
  lensId      String?    @map("lens_id")
  lens        Lens?      @relation(fields: [lensId], references: [id], onDelete: Restrict)
  accessoryId String?    @map("accessory_id")
  accessory   Accessory? @relation(fields: [accessoryId], references: [id])

  /// What was sold, as printed — copied from the product so it survives later edits.
  description    String
  /// right | left | both — for lenses.
  eye            String?
  quantity       Int     @default(1)
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String?   @map("order_id")
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId    String?   @map("customer_id")
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amountCents   Int       @map("amount_cents")
  paidAt        DateTime  @default(now()) @map("paid_at")
  /// For a post-dated cheque.
  chequeDueDate DateTime? @map("cheque_due_date")
  notes         String?

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([customerId])
  @@map("payments")
}

model Invoice {
  id              String    @id @default(uuid())
  /// Printed number, e.g. FAC-2026-0042. Unique per shop.
  number          String
  /// invoice | quote | delivery_note
  kind            String    @default("invoice")
  orderId         String?   @map("order_id")
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId      String?   @map("customer_id")
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedAt        DateTime  @default(now()) @map("issued_at")
  subtotalCents   Int       @default(0) @map("subtotal_cents")
  discountCents   Int       @default(0) @map("discount_cents")
  vatCents        Int       @default(0) @map("vat_cents")
  totalCents      Int       @default(0) @map("total_cents")
  // Copied at issue time: a printed invoice must not change when the customer's details do.
  customerName    String?   @map("customer_name")
  customerAddress String?   @map("customer_address")

  items InvoiceItem[]

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantKey, number])
  @@index([customerId])
  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String  @map("invoice_id")
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@map("invoice_items")
}

model NumberSequence {
  id         String @id @default(uuid())
  /// order | invoice | quote | delivery_note
  kind       String
  year       Int
  /// Distinguishes devices that number documents offline, so two of them never issue the same number.
  series     String @default("")
  prefix     String @default("")
  lastNumber Int    @default(0) @map("last_number")

  tenantKey String   @map("tenant_key")
  tenant    Tenant   @relation(fields: [tenantKey], references: [key])
  /// Whether this row has been sent to the backend. Local-only column.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantKey, kind, year, series])
  @@map("number_sequences")
}

/// Deletions that still have to reach the server. A frame, accessory or photo is deleted from this computer at once; the
/// server (its database row and its photo files) is told through the server's DELETE endpoints, and until it has been, the
/// deletion waits here. Local-only table: it is never sent anywhere.
model PendingDeletion {
  id        Int      @id @default(autoincrement())
  /// frame | accessory | photo
  kind      String
  /// The id of the frame, accessory or photo.
  targetId  String   @map("target_id")
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, targetId])
  @@map("pending_deletions")
}

/// When this installation's licence runs out. Local-only table: it is never sent anywhere (it has no tenant_key and no synced column, so the
/// table API does not know it). At most one row, with id 1.
model LicenseExpiry {
  id        Int      @id @default(1)
  /// The day after which the licence is no longer valid.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("license_expiry")
}
