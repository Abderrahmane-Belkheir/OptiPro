# systemd unit for running the backend as a service on the production host.
#
# This whole deploy/ folder gets copied to the server as one unit (e.g. via
# scp -r deploy/ user@server:/opt/optician-backend), so WorkingDirectory below points at the
# app/ subfolder next to this file wherever that lands — e.g. /opt/optician-backend/app.
#
# Install:
#   sudo cp optician-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now optician-backend
#
# Fill in the placeholders below first. Node needs permission to bind 80/443 without running as
# root — see README.md for the `setcap` step.

[Unit]
Description=Optician backend (Express + Prisma)
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/REPLACE/WITH/PATH/TO/deploy/app
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://REPLACE:REPLACE@localhost:5432/REPLACE?schema=public
Environment=SSL_KEY_PATH=/etc/letsencrypt/live/REPLACE_WITH_DOMAIN/privkey.pem
Environment=SSL_CERT_PATH=/etc/letsencrypt/live/REPLACE_WITH_DOMAIN/fullchain.pem
Environment=ACME_WEBROOT_PATH=/var/www/certbot

[Install]
WantedBy=multi-user.target
