// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  // lets a query load a relation with one SQL join (relationLoadStrategy: "join"): used to read a
  // frame's or accessory's photo ids together with the product itself
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Brand {
  /// A UUID made by the desktop app (the same id on both sides).
  id   String @id
  name String

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  frames Frame[]

  @@unique([tenantKey, name])
  @@map("brands")
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique
  imageUrl String @map("image_url")

  frames Frame[]

  @@map("categories")
}

model Frame {
  id       String   @id
  /// The shop's own short code (what labels and the website show): unique per shop, the public key of a product (abc-123).
  code     String?
  name     String
  price    Float?
  currency String?
  images   String[]
  shape    String?
  colors   String[]
  stock    Int      @default(0)

  brandId    String   @map("brand_id")
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  productImages ProductImage[]

  @@unique([tenantKey, code])
  @@map("frames")
}

model Accessory {
  id          String   @id
  /// The shop's own short code (what labels and the website show): unique per shop.
  code        String?
  name        String
  description String
  price       Float?
  currency    String?
  images      String[]
  stock       Int      @default(0)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key])

  productImages ProductImage[]

  @@unique([tenantKey, code])
  @@map("accessories")
}

model Tenant {
  key  String @id
  host String @unique
  name String

  instagramUrl String? @map("instagram_url")
  tiktokUrl    String? @map("tiktok_url")
  phone        String?
  email        String?
  address      String?

  brands        Brand[]
  frames        Frame[]
  accessories   Accessory[]
  productImages ProductImage[]

  @@map("tenants")
}

// The photos of a product: one row per photo, belonging to EITHER a frame OR an accessory (the table's
// CHECK keeps exactly one of frameId / accessoryId filled). The row's id is the photo's id: what the
// frame/accessory answers list in `imageIds`, and the name of the file in the images folder.
model ProductImage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  frameId     String?    @map("frame_id")
  frame       Frame?     @relation(fields: [frameId], references: [id], onDelete: Cascade)
  accessoryId String?    @map("accessory_id")
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  tenantKey String @map("tenant_key")
  tenant    Tenant @relation(fields: [tenantKey], references: [key], onDelete: Cascade)

  @@map("product_images")
}
