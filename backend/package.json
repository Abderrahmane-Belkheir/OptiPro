{
  "name": "optician-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mock REST API backing the Maison Clair website: categories, brands, frames, accessories, and site info.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.mjs",
    "seed:drop": "node scripts/seed.mjs --drop",
    "check:references": "node scripts/check-references.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
